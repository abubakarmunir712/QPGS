@{
    ViewData["Title"] = "Chapter";
}
<link rel="stylesheet" href="~/css/chapters.css">

<div class="container chap-container">
    <div class="row">
        <div class="col-12 text-start">
            <div class="d-flex align-items-center position-relative top-left-corner">
                <img src="~/Assets/books.png" alt="Books Icon" class="classes-left-icon me-2">
                <h2>Syllabus of Class-1</h2>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Chapter list (left side) -->
        <div class="col-lg-8 col-md-12 chapter-list">
            <!-- Sample chapter boxes -->
            
        
            
        </div>

        <!-- Rubrics Section (right side) -->
        <div class="col-lg-4 col-md-12 mt-3 mt-lg-0">
            <div class="rubrics-box p-3">
                <h5>Following are the Rubric of this subject</h5>
                <ul class="list-group mt-3">
                    <li class="list-group-item">R-1: Remember & Identification</li>
                    <li class="list-group-item">R-2: Use of items</li>
                    <li class="list-group-item">R-3: Understanding</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="~/js/chapters.js"></script>
