@{
    ViewData["Title"] = "Admin";
}
<link rel="stylesheet" href="~/css/admin.css">
<div class="inner-container">
    <div id='class' class="box">
        <img src="~/Assets/classes.png" alt="Classes" class="box-icon">
        <div class="box-title">Manage Classes</div>
    </div>
    <div id='subject' class="box">
        <img src="~/Assets/subjects.png" alt="Subjects" class="box-icon">
        <div class="box-title">Manage Subjects</div>
    </div>
    <div id='chapter' class="box">
        <img src="~/Assets/generate-paper.png" alt="Generate Paper" class="box-icon">
        <div class="box-title">Manage Chapters</div>
    </div>
    <div id='question' class="box">
        <img src="~/Assets/question.png" alt="Generate Paper" class="box-icon">
        <div class="box-title">Manage Questions</div>
    </div>
</div>


<script>
    CheckLogin("admin")
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelector('#class').addEventListener('click', () => {
            window.location.href = 'admin/classes'
        })
        document.querySelector('#subject').addEventListener('click', () => {
            window.location.href = 'admin/subjects'
        })
        document.querySelector('#chapter').addEventListener('click', () => {
            window.location.href = 'admin/chapters'
        })
        document.querySelector('#question').addEventListener('click',()=>{
            window.location.href = 'admin/questions'
        })
    })
</script>